# host port
PORT=8080
# unopened snaps burn after this many hours
SNAP_TTL_HOURS=24
# upload limits: largest snap file, longest video, recording bitrate (sets video size,
# whatever the resolution), and a per-user daily total (0 = none). See docs/deploy.md.
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=30
VIDEO_KBPS=6000
DAILY_UPLOAD_MB=500
# passkey relying-party id; defaults to the hostname the app is served on
# RP_ID=snap.example.com
# contact for push services (mailto: or https:)
# VAPID_SUBJECT=mailto:you@example.com
# IP(s) of your reverse proxy as the container sees it, comma separated, or * if only the
# proxy can reach the port. Without it every visitor looks like the proxy's IP to the rate limits.
# FORWARDED_ALLOW_IPS=172.18.0.1
